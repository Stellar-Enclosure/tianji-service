{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "Tianji owned BPMN migration preflight",
    "version": "1.0.0"
  },
  "paths": {
    "/api/tianji/v1/process-instances/{instanceId}/migration-preflight": {
      "get": {
        "operationId": "getOwnedProcessMigrationPreflight",
        "summary": "Inspect an owned single-instance BPMN migration structure",
        "description": "Requires both existing Process scopes and the dedicated current resource. Native validation is only a structural observation. The original instance and target release guards must resolve the same actor.",
        "security": [
          {
            "oauth2": [
              "tianji:process:read",
              "tianji:process:release:read"
            ]
          }
        ],
        "x-required-permissions": [
          "TIANJI_PROCESS_READ",
          "TIANJI_PROCESS_RELEASE_READ"
        ],
        "x-resource-key": "tianji.api.process.migration.preflight",
        "x-allowed-principals": [
          "USER",
          "SERVICE"
        ],
        "parameters": [
          {
            "name": "instanceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            }
          },
          {
            "name": "X-Egon-Tianji-Tenant",
            "in": "header",
            "required": false,
            "description": "Existing optional tenant consistency assertion.",
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$"
            }
          },
          {
            "name": "targetReleaseVersion",
            "in": "query",
            "required": true,
            "description": "One exact target release from current authorized release metadata.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
            }
          },
          {
            "name": "expectedTargetManifestSha256",
            "in": "query",
            "required": true,
            "description": "Independently pinned target manifest digest, exact lowercase SHA-256.",
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Closed structural observation. Target unavailable and pin mismatch are explicit statuses.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Preflight"
                }
              }
            }
          },
          "400": {
            "description": "Invalid instance identifier or target release pin.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Current Process or release read authorization denied.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No exact owned START instance was found.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Tenant context changed.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Required Process preflight evidence or dependency unavailable.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "oauth2": {
        "type": "oauth2",
        "description": "Example URLs. Deployments configure their existing identity endpoints.",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://identity.example/authorize",
            "tokenUrl": "https://identity.example/token",
            "scopes": {
              "tianji:process:read": "Read owned Process instances",
              "tianji:process:release:read": "Read Process release metadata"
            }
          },
          "clientCredentials": {
            "tokenUrl": "https://identity.example/token",
            "scopes": {
              "tianji:process:read": "Read owned Process instances",
              "tianji:process:release:read": "Read Process release metadata"
            }
          }
        }
      }
    },
    "schemas": {
      "Preflight": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "instanceId",
          "sourceReleaseVersion",
          "targetReleaseVersion",
          "status",
          "activityId",
          "observedAt"
        ],
        "properties": {
          "instanceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "sourceReleaseVersion": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "targetReleaseVersion": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "NATIVE_STRUCTURE_VALIDATED_ONLY",
              "INSTANCE_NOT_LIVE",
              "TARGET_UNAVAILABLE",
              "TARGET_PIN_MISMATCH",
              "RELEASE_PAIR_UNSUPPORTED",
              "SHAPE_UNSUPPORTED",
              "ACTIVE_EVIDENCE_UNSAFE",
              "NATIVE_REJECTED"
            ]
          },
          "activityId": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,127}$"
          },
          "observedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "NATIVE_STRUCTURE_VALIDATED_ONLY",
                    "NATIVE_REJECTED"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "activityId": {
                  "type": "string"
                }
              }
            },
            "else": {
              "properties": {
                "activityId": {
                  "type": "null"
                }
              }
            }
          }
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "correlationId"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^TIANJI_[A-Z_]+$"
          },
          "correlationId": {
            "type": "null"
          }
        }
      }
    }
  }
}
