          {
            "oauth2": [
              "tianji:process:agent-result:receive"
            ]
          }
        ],
        "x-required-permissions": [
          "TIANJI_AGENT_RESULT_RECEIVE"
        ],
        "x-resource-key": "tianji.api.process.agent.result.receive",
        "x-allowed-principals": [
          "SERVICE"
        ],
        "parameters": [
          {
            "name": "X-Egon-Tianji-Tenant",
            "in": "header",
            "required": false,
            "description": "Optional assertion equal to the verified tenant. The trusted identity selects the tenant.",
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}(?![\\s\\S])",
              "maxLength": 19
            }
          }
        ],
