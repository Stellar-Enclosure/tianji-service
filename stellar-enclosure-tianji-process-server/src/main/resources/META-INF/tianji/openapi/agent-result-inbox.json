            "maxLength": 255,
            "pattern": "^(?! )[^\\u0000-\\u001f\\u007f]*[^ \\u0000-\\u001f\\u007f](?![\\s\\S])",
            "description": "At most 512 bytes in UTF-8."
          },
          "activityOccurrenceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "^(?! )[^\\u0000-\\u001f\\u007f]*[^ \\u0000-\\u001f\\u007f](?![\\s\\S])",
            "description": "At most 512 bytes in UTF-8."
          },
          "definitionContentSha256": {
            "$ref": "#/components/schemas/Sha256"
          },
          "dispatchNotAfter": {
            "$ref": "#/components/schemas/UtcMicros"
          }
        }
      },
      "AgentResultArtifactRefVO": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "resourceKey",
          "contentSha256",
          "mediaType",
          "sizeBytes"
        ],
        "properties": {
          "resourceKey": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}(?![\\s\\S])",
            "maxLength": 128
          },
          "contentSha256": {
            "$ref": "#/components/schemas/Sha256"
          },
          "mediaType": {
            "type": "string",
            "pattern": "^[a-z0-9.+-]{1,63}/[a-z0-9.+-]{1,63}(?![\\s\\S])",
            "maxLength": 127
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 999999999999999
          }
        },
        "description": "Opaque immutable result metadata for a frozen reference-mode output schema. The receiver verifies current permission and registered SPI-012 metadata. The event carries no location, access token or artifact body."
      },
      "AgentResultReceipt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "eventId",
          "eventFingerprint",
          "state",
          "receivedAt"
        ],
        "properties": {
          "eventId": {
            "$ref": "#/components/schemas/Sha256"
          },
          "eventFingerprint": {
            "$ref": "#/components/schemas/Sha256"
          },
          "state": {
            "type": "string",
            "enum": [
              "RECEIVED",
              "APPLIED",
              "IGNORED_LATE",
              "DEAD"
            ]
          },
          "receivedAt": {
            "$ref": "#/components/schemas/UtcMicros"
          }
        }
      },
      "Sha256": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
        "maxLength": 64
      },
      "UtcMicros": {
        "type": "string",
        "pattern": "^(?:19[7-9][0-9]|[2-9][0-9]{3})-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9](?:\\.[0-9]{1,6})?Z(?![\\s\\S])",
        "maxLength": 27,
        "format": "date-time",
        "description": "Valid UTC instant from 1970 through year 9999, with at most six fractional digits."
      },
      "TypedJsonValue": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/TypedJsonValue"
            }
          },
          {
            "type": "array",
            "maxItems": 256,
            "items": {
              "$ref": "#/components/schemas/TypedJsonValue"
            }
          },
          {
            "type": "integer",
            "minimum": -999999999999999,
            "maximum": 999999999999999
          },
          {
            "type": [
              "string",
              "boolean",
              "null"
            ]
          }
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "correlationId"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,63}(?![\\s\\S])",
            "maxLength": 64
          },
          "correlationId": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "SecurityError": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "TIANJI_UNAUTHENTICATED",
              "TIANJI_PERMISSION_DENIED"
            ]
          }
        }
      }
    }
  }
}
