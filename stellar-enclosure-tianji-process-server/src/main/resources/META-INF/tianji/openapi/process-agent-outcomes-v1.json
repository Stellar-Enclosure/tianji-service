{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "Tianji Owned Process Agent Outcomes",
    "version": "1.0.0"
  },
  "paths": {
    "/api/tianji/v1/process-instances/{instanceId}/agent-outcomes": {
      "get": {
        "operationId": "getOwnedProcessAgentOutcomes",
        "summary": "Read Process-local Agent dispatch and result evidence",
        "description": "Returns up to 20 observations for the current verified START owner and current configured Process source. An observed Agent terminal status comes from a verified matching local Inbox record. The cursor is opaque and bound to the same current owner and Process instance. The route requires the existing Process API, Agent results and owner-outcomes switches.",
        "security": [
          {
            "oauth2": [
              "tianji:process:read"
            ]
          }
        ],
        "x-required-permissions": [
          "TIANJI_PROCESS_READ"
        ],
        "x-resource-key": "tianji.api.process.agent.outcomes",
        "x-allowed-principals": [
          "USER",
          "SERVICE"
        ],
        "parameters": [
          {
            "name": "instanceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "Opaque continuation from the preceding page.",
            "schema": {
              "type": "string",
              "pattern": "^v1\\.[0-9a-f]{64}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Process-local outcome observations.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or cursor.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Current Process read policy denied.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "The owned Process START or enabled route is unavailable.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Tenant context changed.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Process evidence unavailable or exceeds the supported scan bound.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "oauth2": {
        "type": "oauth2",
        "description": "Example URLs. Deployments configure their existing identity endpoints.",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://identity.example/authorize",
            "tokenUrl": "https://identity.example/token",
            "scopes": {
              "tianji:process:read": "Read owned Process instances"
            }
          },
          "clientCredentials": {
            "tokenUrl": "https://identity.example/token",
            "scopes": {
              "tianji:process:read": "Read owned Process instances"
            }
          }
        }
      }
    },
    "schemas": {
      "Page": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "instanceId",
          "observedAt",
          "items",
          "nextCursor"
        ],
        "properties": {
          "instanceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "observedAt": {
            "type": "string",
            "format": "date-time"
          },
          "items": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "$ref": "#/components/schemas/Item"
            }
          },
          "nextCursor": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^v1\\.[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "Item": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "activityId",
          "dispatchState",
          "inboxState",
          "terminalStatus",
          "dispatchRecordedAt",
          "receivedAt",
          "decidedAt"
        ],
        "properties": {
          "activityId": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,127}$"
          },
          "dispatchState": {
            "type": "string",
            "enum": [
              "PENDING",
              "SUBMITTED",
              "ACKNOWLEDGED",
              "CLOSING",
              "CLOSED"
            ]
          },
          "inboxState": {
            "type": "string",
            "enum": [
              "RUN_NOT_CONFIRMED",
              "NOT_OBSERVED",
              "RECEIVED",
              "APPLIED",
              "IGNORED_LATE",
              "DEAD"
            ]
          },
          "terminalStatus": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "COMPLETED",
                  "FAILED",
                  "CANCELLED",
                  "TIMED_OUT"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "dispatchRecordedAt": {
            "type": "string",
            "format": "date-time"
          },
          "receivedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "decidedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "correlationId"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^TIANJI_[A-Z_]+$"
          },
          "correlationId": {
            "type": "null"
          }
        }
      }
    }
  }
}
