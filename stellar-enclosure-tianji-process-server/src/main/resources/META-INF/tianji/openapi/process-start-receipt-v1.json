{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "Tianji Owned Process START Receipt",
    "version": "1.0.0"
  },
  "paths": {
    "/api/tianji/v1/process-start-receipts": {
      "get": {
        "operationId": "getOwnedProcessStartReceipt",
        "summary": "Read one exact owned applied Process START receipt",
        "description": "Requires the existing Process API and an explicit default-off START receipt read opt-in. Requires the current exact START owner and an independently computed expected request digest from the original intent. An exact APPLIED result proves the original START committed. For v2, the server verifies the immutable instance binding and matching original and resolved digests against the receipt. Only the two query parameters shown are accepted.",
        "security": [
          {
            "oauth2": [
              "tianji:process:read"
            ]
          }
        ],
        "x-required-permissions": [
          "TIANJI_PROCESS_READ"
        ],
        "x-resource-key": "tianji.api.process.startReceipt.get",
        "x-allowed-principals": [
          "USER",
          "SERVICE"
        ],
        "parameters": [
          {
            "name": "commandId",
            "in": "query",
            "required": true,
            "description": "Original exact scoped START command identifier.",
            "schema": {
              "type": "string",
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            }
          },
          {
            "name": "requestSha256",
            "in": "query",
            "required": true,
            "description": "Expected lowercase SHA-256, computed independently from the original START intent. V1 retains OrchestrationRequestDigests.start. V2 uses AUTOMATION_START_REQUEST_V2 and the length-prefixed canonical encoding of definitionKey, businessKey, correlationId, variables and agentTaskOverrides before schema normalization. Preserve originally sent string literals and exact integers; omitted agentTaskOverrides alone becomes an empty object. Exclude commandId, the server-selected release and activation, and the resolved digest. This digest does not confer authority.",
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A matching applied START receipt. The response does not report current Process lifecycle.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StartReceipt"
                }
              }
            }
          },
          "400": {
            "description": "Malformed or extra query parameters.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Current permission, scope or resource policy denied.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No exact owned APPLIED START receipt was observed. Missing, non-APPLIED, different digest and foreign owner are indistinguishable. A 404 is inconclusive; recheck the same commandId and digest within a bounded read window. It does not authorize a new START or a changed key or input.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Tenant context changed.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "The Process store is unavailable, or the preserved v2 binding, receipt, or digest evidence is inconsistent. Keep the result unknown and recheck the original receipt within the read window.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "oauth2": {
        "type": "oauth2",
        "description": "Example URLs describe the existing user and service scopes. Deployments provide their own identity endpoints.",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://identity.example/authorize",
            "tokenUrl": "https://identity.example/token",
            "scopes": {
              "tianji:process:read": "Read owned process instances"
            }
          },
          "clientCredentials": {
            "tokenUrl": "https://identity.example/token",
            "scopes": {
              "tianji:process:read": "Read owned process instances"
            }
          }
        }
      }
    },
    "schemas": {
      "StartReceipt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "instanceId",
          "status",
          "recordedAt"
        ],
        "properties": {
          "instanceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "description": "Existing Process instance reference, not an engine snapshot."
          },
          "status": {
            "type": "string",
            "const": "APPLIED",
            "description": "Receipt status, not live Process status."
          },
          "recordedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$",
            "description": "UTC receipt creation instant in the transaction that committed APPLIED. Not a commit clock."
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "correlationId"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^TIANJI_[A-Z_]+$"
          },
          "correlationId": {
            "type": "null"
          }
        }
      }
    }
  }
}
