{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "Tianji Agent owner recovery evidence",
    "version": "1.0.0"
  },
  "paths": {
    "/api/tianji/v1/agent-runs/{runId}/recovery-disposition": {
      "get": {
        "operationId": "getOwnedAgentRecoveryDisposition",
        "summary": "Observe local recovery evidence for one owned Agent run",
        "description": "Requires the dedicated current resource and exact run owner. Read-only and default disabled. No query parameters are admitted.",
        "security": [
          {
            "oauth2": [
              "tianji:agent:read"
            ]
          }
        ],
        "x-required-permissions": [
          "TIANJI_AGENT_READ"
        ],
        "x-resource-key": "tianji.api.agent.recovery.disposition",
        "x-allowed-principals": [
          "USER",
          "SERVICE"
        ],
        "parameters": [
          {
            "name": "runId",
            "in": "path",
            "required": true,
            "description": "Exact current owned run identifier, 1\u201364 characters.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          {
            "name": "X-Egon-Tianji-Tenant",
            "in": "header",
            "required": false,
            "description": "Optional assertion matching the already authenticated tenant; does not select authority.",
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "One current owner-local recovery observation. It confers no recovery authority.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Disposition"
                }
              }
            }
          },
          "400": {
            "description": "Invalid exact run identifier or an unexpected query parameter.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Current Agent read permission or policy denied.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No exact owned run matches the requested identifier.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Tenant context changed.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Agent store or permission dependency unavailable.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "oauth2": {
        "type": "oauth2",
        "description": "Deployment supplies its existing identity endpoints.",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://identity.example/authorize",
            "tokenUrl": "https://identity.example/token",
            "scopes": {
              "tianji:agent:read": "Read owned Agent runs"
            }
          },
          "clientCredentials": {
            "tokenUrl": "https://identity.example/token",
            "scopes": {
              "tianji:agent:read": "Read owned Agent runs"
            }
          }
        }
      }
    },
    "schemas": {
      "Disposition": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "runId",
          "observedAt",
          "lifecycle",
          "reason",
          "agentEffect",
          "toolEvidence",
          "evidenceConflict"
        ],
        "properties": {
          "runId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "observedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
          },
          "lifecycle": {
            "type": "string",
            "enum": [
              "QUEUED",
              "ACTIVE",
              "STALLED",
              "TERMINAL",
              "UNVERIFIED"
            ]
          },
          "reason": {
            "type": "string",
            "enum": [
              "QUEUE_DISCOVERY",
              "CURRENT_LEASE",
              "CANCEL_REQUESTED",
              "DEADLINE_DUE",
              "LEASE_MISSING",
              "LEASE_EXPIRED",
              "AUTHORIZATION_DENIED",
              "AUTHORIZATION_UNAVAILABLE",
              "FENCE_UNVERIFIED",
              "SUSPENSION_UNVERIFIED",
              "LEGACY_WAIT_UNVERIFIED",
              "TERMINAL_RECORDED",
              "SOURCE_UNAVAILABLE"
            ]
          },
          "agentEffect": {
            "type": "string",
            "enum": [
              "RECORDED_NONE",
              "RECORDED_CONFIRMED",
              "UNKNOWN",
              "UNVERIFIED"
            ]
          },
          "toolEvidence": {
            "$ref": "#/components/schemas/ToolEvidence"
          },
          "evidenceConflict": {
            "type": "boolean",
            "description": "True exactly when a recorded NONE conflicts with a positive unresolved-write observation."
          }
        }
      },
      "ToolEvidence": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "coverage",
          "hasDispatching",
          "hasUnknownResult",
          "hasUnresolvedWrite",
          "hasLocalReceipt"
        ],
        "properties": {
          "coverage": {
            "type": "string",
            "enum": [
              "COMPLETE",
              "TRUNCATED",
              "UNAVAILABLE"
            ]
          },
          "hasDispatching": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "hasUnknownResult": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "hasUnresolvedWrite": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "hasLocalReceipt": {
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "coverage": {
                  "const": "COMPLETE"
                }
              }
            },
            "then": {
              "properties": {
                "hasDispatching": {
                  "type": "boolean"
                },
                "hasUnknownResult": {
                  "type": "boolean"
                },
                "hasUnresolvedWrite": {
                  "type": "boolean"
                },
                "hasLocalReceipt": {
                  "type": "boolean"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "coverage": {
                  "const": "TRUNCATED"
                }
              }
            },
            "then": {
              "properties": {
                "hasDispatching": {
                  "enum": [
                    true,
                    null
                  ]
                },
                "hasUnknownResult": {
                  "enum": [
                    true,
                    null
                  ]
                },
                "hasUnresolvedWrite": {
                  "enum": [
                    true,
                    null
                  ]
                },
                "hasLocalReceipt": {
                  "enum": [
                    true,
                    null
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "coverage": {
                  "const": "UNAVAILABLE"
                }
              }
            },
            "then": {
              "properties": {
                "hasDispatching": {
                  "type": "null"
                },
                "hasUnknownResult": {
                  "type": "null"
                },
                "hasUnresolvedWrite": {
                  "type": "null"
                },
                "hasLocalReceipt": {
                  "type": "null"
                }
              }
            }
          }
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^TIANJI_[A-Z_]+$"
          },
          "correlationId": {
            "type": [
              "string",
              "null"
            ]
          },
          "message": {
            "type": "string"
          },
          "decisionId": {
            "type": [
              "string",
              "null"
            ]
          },
          "retryAfter": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
