                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrchestrationErrorDTO",
                  "properties": {
                    "code": {
                      "enum": [
                        "TIANJI_RESOURCE_NOT_FOUND"
                      ]
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "Safe documented failure; no automatic mutation retry.",
            "headers": {
              "Cache-Control": {
                "description": "Provider returns no-store. SDK sends no-store and does not enforce this response header.",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrchestrationErrorDTO",
                  "properties": {
                    "code": {
                      "enum": [
                        "TIANJI_IDEMPOTENCY_CONFLICT",
                        "TIANJI_PROCESS_VERSION_CONFLICT",
                        "TIANJI_PROCESS_CANCEL_BLOCKED",
                        "TIANJI_TENANT_CONTEXT_CHANGED"
                      ]
                    }
                  }
                }
              }
