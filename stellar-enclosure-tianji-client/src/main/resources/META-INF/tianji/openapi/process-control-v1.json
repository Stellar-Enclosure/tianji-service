                    "code": {
                      "enum": [
                        "TIANJI_REQUEST_TOO_LARGE"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "description": "Strict four-member JSON, max4KiB; duplicate/unknown/trailing/scalar/null violations fail before mutation.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CancelProcessCommand"
              },
              "example": {
                "instanceId": "process-1",
                "commandId": "cancel-1",
                "expectedVersion": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
                "reason": "Invoice withdrawn"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "oauth2": {
        "type": "oauth2",
        "description": "Bearer access token from the existing configured issuer; both scopes and current backend permission checks are mandatory for USER and SERVICE. Synthetic URLs do not configure a new OAuth client.",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://identity.example/oauth/authorize",
            "tokenUrl": "https://identity.example/oauth/token",
            "scopes": {
              "tianji:process:read": "Read the exact owned process.",
              "tianji:process:cancel": "Read control and cancel an eligible exact-owned process."
            }
          },
          "clientCredentials": {
            "tokenUrl": "https://identity.example/oauth/token",
            "scopes": {
              "tianji:process:read": "Read the exact owned process.",
              "tianji:process:cancel": "Read control and cancel an eligible exact-owned process."
            }
          }
        }
      }
    },
    "schemas": {
      "ProcessActiveWaitKindEnum": {
        "type": "string",
        "enum": [
          "HUMAN_TASK",
          "EXTERNAL_WORKER",
          "AGENT_RESULT_WAIT",
          "CASE_COMPLETION_WAIT",
          "TIMER"
        ]
      },
      "ProcessControlActionEnum": {
        "type": "string",
        "enum": [
          "CANCEL"
        ]
      },
      "ProcessControlBlockReasonEnum": {
        "type": "string",
        "enum": [
          "NONE",
          "PROCESS_TERMINAL",
          "MODEL_CONTAINS_CASE_SOURCE"
        ]
      },
      "ProcessInstanceStatusEnum": {
        "type": "string",
        "enum": [
          "ACTIVE",
          "SUSPENDED",
          "COMPLETED",
          "CANCELLED"
        ]
      },
      "ProcessInstanceDTO": {
        "type": "object",
        "description": "Existing eight-field process representation remains unchanged.",
        "additionalProperties": false,
        "required": [
          "instanceId",
          "definitionKey",
          "releaseVersion",
          "businessKey",
          "correlationId",
          "status",
          "submittedAt",
          "finishedAt"
        ],
        "properties": {
          "instanceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "description": "Exact safe identifier, at most 255 Java UTF-16 units. Java blank-text and surrogate checks remain authoritative; legal NBSP/BOM are preserved.",
            "x-java-utf16-max-length": 255,
            "pattern": "^(?![\\u0000-\\u0020])(?![\\s\\S]*[\\u0000-\\u0020]$)(?:[^\\u0000-\\u001F\\u007F\\uD800-\\uDFFF]|[\\uD800-\\uDBFF][\\uDC00-\\uDFFF])+$"
          },
          "definitionKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Immutable released activity or definition key.",
            "x-java-utf16-max-length": 128,
            "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,127}$"
          },
          "releaseVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Immutable platform release version.",
            "x-java-utf16-max-length": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "businessKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "description": "Exact safe identifier, at most 255 Java UTF-16 units. Java blank-text and surrogate checks remain authoritative; legal NBSP/BOM are preserved.",
            "x-java-utf16-max-length": 255,
            "pattern": "^(?![\\u0000-\\u0020])(?![\\s\\S]*[\\u0000-\\u0020]$)(?:[^\\u0000-\\u001F\\u007F\\uD800-\\uDFFF]|[\\uD800-\\uDBFF][\\uDC00-\\uDFFF])+$"
          },
          "correlationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Stable caller command/correlation identifier.",
            "x-java-utf16-max-length": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "status": {
            "$ref": "#/components/schemas/ProcessInstanceStatusEnum"
          },
          "submittedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Actual process submission instant; provider emits UTC Z, SDK accepts explicit offsets and nanoseconds."
          },
          "finishedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Required member: null for ACTIVE/SUSPENDED, actual native finish instant for COMPLETED/CANCELLED."
          }
        },
        "oneOf": [
          {
            "properties": {
              "status": {
                "enum": [
                  "ACTIVE",
                  "SUSPENDED"
                ]
              },
              "finishedAt": {
                "type": "null"
              }
            }
          },
          {
            "properties": {
              "status": {
                "enum": [
                  "COMPLETED",
                  "CANCELLED"
                ]
              },
              "finishedAt": {
                "type": "string"
              }
            }
          }
        ]
      },
      "ProcessActiveWaitDTO": {
        "type": "object",
        "description": "One grouped released wait. Counts derive only from verified live Task/ExternalWorkerJob/timer Job/message EventSubscription artifacts; native IDs are not returned.",
        "additionalProperties": false,
        "required": [
          "activityKey",
          "kind",
          "occurrences"
        ],
        "properties": {
          "activityKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Immutable released activity or definition key.",
            "x-java-utf16-max-length": 128,
            "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,127}$"
          },
          "kind": {
            "$ref": "#/components/schemas/ProcessActiveWaitKindEnum"
          },
          "occurrences": {
            "type": "integer",
            "minimum": 1,
            "maximum": 256
          }
        }
      },
      "ProcessControlSnapshotDTO": {
        "type": "object",
        "description": "Independent owner decision view: identity, released current waits, action and block. Command revalidates current authorization and state.",
        "additionalProperties": false,
        "required": [
          "process",
          "activeWaits",
          "allowedActions",
          "cancellationBlockReason",
          "version",
          "observedAt"
        ],
        "properties": {
          "process": {
            "$ref": "#/components/schemas/ProcessInstanceDTO"
          },
          "activeWaits": {
            "type": "array",
            "maxItems": 256,
            "uniqueItems": true,
            "items": {
              "$ref": "#/components/schemas/ProcessActiveWaitDTO"
            },
            "description": "Unique kind/activity pairs in kind-name then activity-key order; summed occurrences <=256. Empty is valid for a live process. Structural/inactive gateway executions are not waits.",
            "x-unique-by": [
              "kind",
              "activityKey"
            ],
            "x-canonical-order": [
              "kind.name",
              "activityKey"
            ],
            "x-aggregate-maximum": {
              "field": "occurrences",
              "maximum": 256
            }
          },
          "allowedActions": {
            "type": "array",
            "maxItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/components/schemas/ProcessControlActionEnum"
            }
          },
          "cancellationBlockReason": {
            "$ref": "#/components/schemas/ProcessControlBlockReasonEnum"
          },
          "version": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[0-9a-f]{64}$",
            "description": "Opaque lower-case SHA-256 token; never authorization or an ordinal."
          },
          "observedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Actual database observation instant in UTC Z; excluded from the opaque version and not a lease."
          }
        },
        "oneOf": [
          {
            "properties": {
              "process": {
                "properties": {
                  "status": {
                    "enum": [
                      "ACTIVE",
                      "SUSPENDED"
                    ]
                  }
                }
              },
              "cancellationBlockReason": {
                "const": "NONE"
              },
              "allowedActions": {
                "minItems": 1
              }
            }
          },
          {
            "properties": {
              "process": {
                "properties": {
                  "status": {
                    "enum": [
                      "ACTIVE",
