{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "Tianji Process Control Consumer Contract",
    "version": "1.0.0",
    "description": "Contract-first consumer authority. Provider source is implemented in Step 4; stellar.tianji.process.cancellation.enabled=false by default. Runtime PostgreSQL/Flowable/IAM acceptance is unverified. Existing caller supplies bearer credentials; illustrative identity.example OAuth URLs are documentation only. Token retrieval precedes the configured HTTP timeout. SDK follows existing Process HTTP/HTTPS and Redirect.NEVER constructor policy, sends each mutation once, requires exact200 JSON/+json and caps response bytes at2MiB. No registration, activation or role grant occurs."
  },
  "tags": [
    {
      "name": "Process control",
      "description": "Exact-owner bounded BPMN control and cancellation; no admin, Case cancellation, compensation or arbitrary node movement."
    }
  ],
  "paths": {
    "/api/tianji/v1/process-instances/{instanceId}/control": {
      "get": {
        "operationId": "getProcessControl",
        "tags": [
          "Process control"
        ],
        "summary": "Review current owned process control facts",
        "description": "Current verified USER or SERVICE must be the exact APPLIED START owner and hold both READ and CANCEL. Tenant/issuer/subject come only from trusted identity. SDK sends once; caller retains the exact command after an unknown outcome. Native Case-containing models are blocked. Remote linked-Agent close runs later outside the local transaction.",
        "security": [
          {
            "oauth2": [
              "tianji:process:read",
              "tianji:process:cancel"
            ]
          }
        ],
        "x-required-permissions": [
          "TIANJI_PROCESS_READ",
          "TIANJI_PROCESS_CANCEL"
        ],
        "x-resource-key": "tianji.api.process.instance.control",
        "x-allowed-principals": [
          "USER",
          "SERVICE"
        ],
        "parameters": [
          {
            "name": "instanceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255,
              "description": "Exact safe identifier, at most 255 Java UTF-16 units. Java blank-text and surrogate checks remain authoritative; legal NBSP/BOM are preserved.",
              "x-java-utf16-max-length": 255,
              "pattern": "^(?![\\u0000-\\u0020])(?![\\s\\S]*[\\u0000-\\u0020]$)(?:[^\\u0000-\\u001F\\u007F\\uD800-\\uDFFF]|[\\uD800-\\uDBFF][\\uDC00-\\uDFFF])+$",
              "not": {
                "enum": [
                  ".",
                  ".."
                ]
              }
            }
          },
          {
            "name": "X-Egon-Tianji-Tenant",
            "in": "header",
            "required": false,
            "description": "Optional assertion equal to verified tenant, never tenant selection.",
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current owner control snapshot.",
            "headers": {
              "Cache-Control": {
                "description": "Provider returns no-store. SDK sends no-store and does not enforce this response header.",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProcessControlSnapshotDTO"
                }
              }
            }
          },
          "400": {
            "description": "Safe documented failure; no automatic mutation retry.",
            "headers": {
              "Cache-Control": {
                "description": "Provider returns no-store. SDK sends no-store and does not enforce this response header.",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrchestrationErrorDTO",
                  "properties": {
                    "code": {
                      "enum": [
                        "TIANJI_INVALID_COMMAND"
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Safe documented failure; no automatic mutation retry.",
            "headers": {
              "Cache-Control": {
                "description": "Provider returns no-store. SDK sends no-store and does not enforce this response header.",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrchestrationErrorDTO",
                  "properties": {
                    "code": {
                      "enum": [
                        "TIANJI_UNAUTHENTICATED"
                      ]
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Safe documented failure; no automatic mutation retry.",
            "headers": {
              "Cache-Control": {
                "description": "Provider returns no-store. SDK sends no-store and does not enforce this response header.",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrchestrationErrorDTO",
                  "properties": {
                    "code": {
                      "enum": [
                        "TIANJI_PERMISSION_DENIED"
                      ]
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Safe documented failure; no automatic mutation retry.",
            "headers": {
              "Cache-Control": {
                "description": "Provider returns no-store. SDK sends no-store and does not enforce this response header.",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrchestrationErrorDTO",
                  "properties": {
                    "code": {
                      "enum": [
                        "TIANJI_RESOURCE_NOT_FOUND"
                      ]
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "Safe documented failure; no automatic mutation retry.",
            "headers": {
              "Cache-Control": {
                "description": "Provider returns no-store. SDK sends no-store and does not enforce this response header.",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrchestrationErrorDTO",
                  "properties": {
                    "code": {
                      "enum": [
                        "TIANJI_TENANT_CONTEXT_CHANGED"
                      ]
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Safe documented failure; no automatic mutation retry.",
            "headers": {
              "Cache-Control": {
                "description": "Provider returns no-store. SDK sends no-store and does not enforce this response header.",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrchestrationErrorDTO",
                  "properties": {
                    "code": {
                      "enum": [
                        "TIANJI_INTERNAL_ERROR"
                      ]
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Safe documented failure; no automatic mutation retry.",
            "headers": {
              "Cache-Control": {
                "description": "Provider returns no-store. SDK sends no-store and does not enforce this response header.",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrchestrationErrorDTO",
                  "properties": {
                    "code": {
                      "enum": [
                        "TIANJI_DEPENDENCY_UNAVAILABLE"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/tianji/v1/process-instances/{instanceId}/cancellations": {
