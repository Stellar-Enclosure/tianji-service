        "description": "Current verified USER or SERVICE must be the exact APPLIED START owner and hold both READ and CANCEL. Tenant/issuer/subject come only from trusted identity. SDK sends once; caller retains the exact command after an unknown outcome. Native Case-containing models are blocked. Remote linked-Agent close runs later outside the local transaction.",
        "security": [
          {
            "oauth2": [
              "tianji:process:read",
              "tianji:process:cancel"
            ]
          }
        ],
        "x-required-permissions": [
          "TIANJI_PROCESS_READ",
          "TIANJI_PROCESS_CANCEL"
        ],
        "x-resource-key": "tianji.api.process.instance.cancel",
        "x-allowed-principals": [
          "USER",
          "SERVICE"
        ],
        "parameters": [
          {
            "name": "instanceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255,
              "description": "Exact safe identifier, at most 255 Java UTF-16 units. Java blank-text and surrogate checks remain authoritative; legal NBSP/BOM are preserved.",
              "x-java-utf16-max-length": 255,
              "pattern": "^(?![\\u0000-\\u0020])(?![\\s\\S]*[\\u0000-\\u0020]$)(?:[^\\u0000-\\u001F\\u007F\\uD800-\\uDFFF]|[\\uD800-\\uDBFF][\\uDC00-\\uDFFF])+$",
              "not": {
                "enum": [
                  ".",
                  ".."
                ]
              }
            }
          },
          {
            "name": "X-Egon-Tianji-Tenant",
            "in": "header",
            "required": false,
            "description": "Optional assertion equal to verified tenant, never tenant selection.",
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Committed cancellation/replay/terminal no-op.",
            "headers": {
              "Cache-Control": {
                "description": "Provider returns no-store. SDK sends no-store and does not enforce this response header.",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CancelProcessResult"
