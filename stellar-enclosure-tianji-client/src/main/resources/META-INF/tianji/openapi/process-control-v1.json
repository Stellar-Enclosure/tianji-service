              }
            }
          },
          "400": {
            "description": "Safe documented failure; no automatic mutation retry.",
            "headers": {
              "Cache-Control": {
                "description": "Provider returns no-store. SDK sends no-store and does not enforce this response header.",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrchestrationErrorDTO",
                  "properties": {
                    "code": {
                      "enum": [
                        "TIANJI_INVALID_COMMAND"
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Safe documented failure; no automatic mutation retry.",
            "headers": {
              "Cache-Control": {
                "description": "Provider returns no-store. SDK sends no-store and does not enforce this response header.",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrchestrationErrorDTO",
                  "properties": {
                    "code": {
                      "enum": [
                        "TIANJI_UNAUTHENTICATED"
                      ]
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Safe documented failure; no automatic mutation retry.",
            "headers": {
              "Cache-Control": {
                "description": "Provider returns no-store. SDK sends no-store and does not enforce this response header.",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrchestrationErrorDTO",
                  "properties": {
                    "code": {
                      "enum": [
                        "TIANJI_PERMISSION_DENIED"
                      ]
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Safe documented failure; no automatic mutation retry.",
            "headers": {
              "Cache-Control": {
                "description": "Provider returns no-store. SDK sends no-store and does not enforce this response header.",
                "schema": {
                  "type": "string",
