                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrchestrationErrorDTO",
                  "properties": {
                    "code": {
                      "enum": [
                        "TIANJI_PERMISSION_DENIED"
                      ]
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Safe documented failure.",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrchestrationErrorDTO",
