  "components": {
    "securitySchemes": {
      "oauth2": {
        "type": "oauth2",
        "description": "Bearer access token from the existing configured issuer; both scopes and current backend permission checks are mandatory for USER and SERVICE. Synthetic URLs do not configure a new OAuth client.",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://identity.example/oauth/authorize",
            "tokenUrl": "https://identity.example/oauth/token",
            "scopes": {
              "tianji:process:read": "Read owned process state",
              "tianji:process:worker-recover": "Observe or recover owned process Worker failures"
            }
          },
          "clientCredentials": {
            "tokenUrl": "https://identity.example/oauth/token",
            "scopes": {
              "tianji:process:read": "Read owned process state",
              "tianji:process:worker-recover": "Observe or recover owned process Worker failures"
            }
          }
        }
      }
    },
    "schemas": {
      "ProcessWorkerFailureDTO": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "jobId",
          "activityId",
          "nativeDeadletter",
          "status",
          "reason",
          "reportedFailure",
          "expectedVersion"
        ],
        "properties": {
          "jobId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "x-java-utf16-max-length": 255,
            "pattern": "^(?![\\u0000-\\u0020])(?![\\s\\S]*[\\u0000-\\u0020]$)(?:[^\\u0000-\\u001F\\u007F\\uD800-\\uDFFF]|[\\uD800-\\uDBFF][\\uDC00-\\uDFFF])+$",
            "description": "Exact scoped job identifier. Java blank-text and surrogate checks are authoritative."
          },
          "activityId": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "x-java-utf16-max-length": 128,
                "pattern": "^(?![\\u0000-\\u0020])(?![\\s\\S]*[\\u0000-\\u0020]$)(?:[^\\u0000-\\u001F\\u007F\\uD800-\\uDFFF]|[\\uD800-\\uDBFF][\\uDC00-\\uDFFF])+$",
                "description": "Proved activity identifier when available. Java blank-text and surrogate checks are authoritative."
              },
              {
                "type": "null"
              }
            ]
          },
          "nativeDeadletter": {
            "type": "boolean"
          },
          "status": {
            "$ref": "#/components/schemas/WorkerRecoveryFailureStatusEnum"
          },
          "reason": {
            "$ref": "#/components/schemas/WorkerRecoveryReasonEnum"
          },
          "reportedFailure": {
            "$ref": "#/components/schemas/WorkerRecoveryReportedFailureEnum"
          },
          "expectedVersion": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 64,
                "maxLength": 64,
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "RETRY_AVAILABLE"
                }
              }
            },
            "then": {
              "properties": {
                "nativeDeadletter": {
                  "const": true
                },
                "activityId": {
                  "type": "string"
                },
                "expectedVersion": {
                  "type": "string"
                },
                "reason": {
                  "const": "NONE"
                },
                "reportedFailure": {
                  "const": "RETRYABLE"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "MANUAL_REVIEW"
                }
              }
            },
            "then": {
              "properties": {
                "nativeDeadletter": {
                  "const": true
                },
                "expectedVersion": {
                  "type": "null"
                },
                "reason": {
                  "enum": [
                    "UNKNOWN_OUTCOME",
                    "BUSINESS_REJECTED",
                    "RESTORE_LIMIT_REACHED",
                    "UNSUPPORTED_NATIVE_JOB",
                    "PROCESS_INACTIVE",
                    "EVIDENCE_CONFLICT",
                    "ACTIVE_LEASE",
                    "BINDING_UNVERIFIED",
                    "HISTORY_INCOMPLETE",
                    "UNSUPPORTED_EFFECT"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "HISTORICAL_FAILURE"
                }
              }
            },
            "then": {
              "properties": {
                "nativeDeadletter": {
                  "const": false
                },
                "expectedVersion": {
                  "type": "null"
                },
                "reason": {
                  "enum": [
                    "NO_NATIVE_DEADLETTER",
                    "UNKNOWN_OUTCOME",
                    "BUSINESS_REJECTED",
                    "HISTORY_INCOMPLETE"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "reason": {
                  "const": "UNKNOWN_OUTCOME"
                }
              }
            },
            "then": {
              "properties": {
                "reportedFailure": {
                  "const": "UNKNOWN"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "reason": {
                  "const": "BUSINESS_REJECTED"
                }
              }
            },
            "then": {
              "properties": {
                "reportedFailure": {
                  "const": "BUSINESS_REJECTED"
                }
              }
            }
          }
        ]
      },
      "ProcessWorkerFailuresDTO": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "instanceId",
          "observedAt",
          "failures"
        ],
        "properties": {
          "instanceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "x-java-utf16-max-length": 255,
            "pattern": "^(?![\\u0000-\\u0020])(?![\\s\\S]*[\\u0000-\\u0020]$)(?:[^\\u0000-\\u001F\\u007F\\uD800-\\uDFFF]|[\\uD800-\\uDBFF][\\uDC00-\\uDFFF])+$",
            "description": "Exact process instance ID. Java blank-text and surrogate checks are authoritative.",
            "not": {
              "enum": [
                ".",
                ".."
              ]
            }
          },
          "observedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$",
            "x-canonical-format": "java.time.Instant.toString",
            "description": "ProcessDB snapshot observation sample in UTC."
          },
          "failures": {
            "type": "array",
            "maxItems": 128,
            "uniqueItems": true,
            "x-unique-by": "jobId",
            "x-sort-order": "unsigned-utf8-jobId",
            "items": {
              "$ref": "#/components/schemas/ProcessWorkerFailureDTO"
            }
          }
        }
      },
      "RecoverProcessWorkerCommand": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "instanceId",
          "jobId",
          "commandId",
          "expectedVersion",
          "reason"
        ],
        "properties": {
          "instanceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "x-java-utf16-max-length": 255,
            "pattern": "^(?![\\u0000-\\u0020])(?![\\s\\S]*[\\u0000-\\u0020]$)(?:[^\\u0000-\\u001F\\u007F\\uD800-\\uDFFF]|[\\uD800-\\uDBFF][\\uDC00-\\uDFFF])+$",
            "description": "Exact process instance ID. Java blank-text and surrogate checks are authoritative.",
            "not": {
              "enum": [
                ".",
                ".."
              ]
            }
          },
          "jobId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "x-java-utf16-max-length": 255,
            "pattern": "^(?![\\u0000-\\u0020])(?![\\s\\S]*[\\u0000-\\u0020]$)(?:[^\\u0000-\\u001F\\u007F\\uD800-\\uDFFF]|[\\uD800-\\uDBFF][\\uDC00-\\uDFFF])+$",
            "description": "Exact scoped job identifier. Java blank-text and surrogate checks are authoritative."
          },
          "commandId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "expectedVersion": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[0-9a-f]{64}$"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "x-java-utf16-max-length": 512,
            "pattern": "^(?![\\u0000-\\u0020])(?![\\s\\S]*[\\u0000-\\u0020]$)(?:[^\\u0000-\\u001F\\u007F\\uD800-\\uDFFF]|[\\uD800-\\uDBFF][\\uDC00-\\uDFFF])+$",
            "description": "Exact private operator reason. Accepted text is preserved. Java blank-text and surrogate checks are authoritative."
          }
        }
      },
      "RecoverProcessWorkerResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "instanceId",
          "jobId",
          "occurrenceId",
          "commandId",
          "status",
          "retries",
          "decidedAt"
        ],
        "properties": {
          "instanceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "x-java-utf16-max-length": 255,
            "pattern": "^(?![\\u0000-\\u0020])(?![\\s\\S]*[\\u0000-\\u0020]$)(?:[^\\u0000-\\u001F\\u007F\\uD800-\\uDFFF]|[\\uD800-\\uDBFF][\\uDC00-\\uDFFF])+$",
