            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrchestrationErrorDTO",
                  "properties": {
                    "code": {
                      "enum": [
                        "TIANJI_INVALID_COMMAND"
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Safe documented failure.",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
