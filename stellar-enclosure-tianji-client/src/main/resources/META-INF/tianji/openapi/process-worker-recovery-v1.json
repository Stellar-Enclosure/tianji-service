                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrchestrationErrorDTO",
                  "properties": {
                    "code": {
                      "enum": [
                        "TIANJI_DEPENDENCY_UNAVAILABLE"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/tianji/v1/process-instances/{instanceId}/worker-recoveries": {
