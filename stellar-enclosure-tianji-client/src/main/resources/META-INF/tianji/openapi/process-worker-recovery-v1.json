          {
            "oauth2": [
              "tianji:process:read",
              "tianji:process:worker-recover"
            ]
          }
        ],
        "x-resource-key": "tianji.api.process.instance.worker-failures",
        "x-required-permissions": [
          "TIANJI_PROCESS_READ",
          "TIANJI_PROCESS_WORKER_RECOVER"
        ],
        "x-allowed-principals": [
          "USER",
          "SERVICE"
        ],
        "parameters": [
          {
            "name": "instanceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255,
              "x-java-utf16-max-length": 255,
              "pattern": "^(?![\\u0000-\\u0020])(?![\\s\\S]*[\\u0000-\\u0020]$)(?:[^\\u0000-\\u001F\\u007F\\uD800-\\uDFFF]|[\\uD800-\\uDBFF][\\uDC00-\\uDFFF])+$",
              "description": "Exact process instance ID. Java blank-text and surrogate checks are authoritative.",
              "not": {
                "enum": [
                  ".",
                  ".."
                ]
              }
            }
          },
          {
            "name": "X-Egon-Tianji-Tenant",
            "in": "header",
            "required": false,
            "description": "Optional positive decimal long equal to the verified tenant, with a maximum of 9223372036854775807. Tenant is derived from verified identity.",
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$",
              "x-java-long-max": "9223372036854775807"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Observe a complete bounded failure list for the exact currently authorized START owner.",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProcessWorkerFailuresDTO"
                }
              }
            }
          },
          "400": {
            "description": "Safe documented failure.",
