{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "Tianji Process Worker Recovery Consumer Contract",
    "version": "1.0.0",
    "description": "Contract-first consumer artifact. stellar.tianji.process.worker-recovery.enabled=false by default. Runtime PostgreSQL, Flowable and IAM acceptance is separate. Illustrative identity.example OAuth URLs are documentation only. SDK requires HTTPS or a literal loopback fixture, sends no-store and makes one bounded send per invocation."
  },
  "tags": [
    {
      "name": "Worker recovery",
      "description": "Exact-owner BPMN failure observation and governed retry scheduling."
    }
  ],
  "paths": {
    "/api/tianji/v1/process-instances/{instanceId}/worker-failures": {
      "get": {
        "operationId": "getProcessWorkerFailures",
        "tags": [
          "Worker recovery"
        ],
        "description": "Observe a complete bounded failure list for the exact currently authorized START owner.",
